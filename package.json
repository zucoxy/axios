{
  "name": "@unyu/axios",
  "version": "1.0.1",
  "description": "Secondary packaging of axios, including data caching, request retrying, canceling requests and other functions.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "dev": "tsup src/index.ts --watch --format cjs,esm --dts",
    "build": "tsup src/index.ts --format cjs,esm --dts --dts-resolve",
    "start": "esno src/index.ts",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check": "pnpm run lint && pnpm run test",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "release": "pnpm run build && bumpp --commit --push --tag && pnpm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zucoxy/axios.git"
  },
  "keywords": [
    "axios",
    "javascript",
    "typescript",
    "http",
    "http-client",
    "caching",
    "retry",
    "cancel"
  ],
  "author": "@unyu <1078119795@qq.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zucoxy/axios/issues"
  },
  "homepage": "https://github.com/zucoxy/axios#readme",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lru-cache": "^7.14.1"
  },
  "peerDependencies": {
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "@unyu/eslint-config": "^0.2.0",
    "axios": "^1.18.0",
    "bumpp": "^8.2.1",
    "eslint": "^8.28.0",
    "esno": "^0.16.3",
    "tsup": "^6.7.0",
    "typescript": "^4.9.3",
    "vitest": "^0.25.3"
  }
}
